<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>downstream_bin_a</name>
  <version>0.2.0</version>
  <description>
    Package of the binext distribution of the REP-159 test harness: reads a
    YAML document with libyaml and labels its XML payload through the
    upstream chain, which binext imports as binaries with binary_import.
  </description>
  <maintainer email="jrivero@honurobotics.com">Jose Luis Rivero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>upstream_c</depend>

  <!-- The libyaml key installs only the runtime library (libyaml-0-2 on
       Ubuntu); the headers come from the libyaml-dev key. -->
  <build_depend>libyaml-dev</build_depend>
  <exec_depend>libyaml</exec_depend>

  <!-- A build_depend too: a ros_buildfarm ci job configures the tests in its
       build phase, where test_depend packages are not installed. -->
  <build_depend>gtest</build_depend>
  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
